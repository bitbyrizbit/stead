{
  "manifest_version": 3,
  "name": "STEAD",
  "version": "1.0.0",
  "description": "Your intent, not your tremor. Real-time tremor filtering for accessible browsing.",
  "permissions": ["storage", "activeTab", "scripting"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["dist/content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "STEAD"
  }
}